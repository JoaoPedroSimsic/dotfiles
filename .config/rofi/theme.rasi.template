* {
    bg:       {{BLACK}};
    fg:       {{BASE}};
    accent:   {{BASE}};
    dim:      {{DIM}};

    background-color: transparent;
    text-color:       @fg;
    border-color:     @accent;
}

window {
    background-color: @bg;
    border:           1px;
    border-color:     @accent;
    border-radius:    0px;
    width:            400px;
    padding:          0px;
}

mainbox {
    background-color: @bg;
    children:         [ inputbar, listview ];
    spacing:          0px;
    padding:          0px;
}

inputbar {
    background-color: @bg;
    border:           1px;
    border-color:     @accent;
    border-radius:    0px;
    padding:          8px 12px;
    margin:           8px 8px 4px 8px;
    children:         [ prompt, textbox-prompt-colon, entry ];
}

prompt {
    background-color: transparent;
    text-color:       @accent;
}

textbox-prompt-colon {
    expand:           false;
    str:              "";
    background-color: transparent;
    text-color:       @accent;
}

entry {
    background-color: transparent;
    text-color:       @fg;
    cursor:           block;
    cursor-color:     @accent;
    placeholder:      "";
}

listview {
    background-color: @bg;
    border:           1px;
    border-color:     @accent;
    border-radius:    0px;
    padding:          4px 0px;
    margin:           4px 8px 8px 8px;
    lines:            12;
    columns:          1;
    fixed-height:     true;
    scrollbar:        false;
}

element {
    background-color: transparent;
    text-color:       @fg;
    padding:          4px 12px;
    border-radius:    0px;
}

element selected.normal {
    background-color: @accent;
    text-color:       @bg;
}

element selected.active {
    background-color: @accent;
    text-color:       @bg;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    highlight:        none;
}
