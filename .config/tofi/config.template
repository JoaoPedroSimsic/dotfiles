# Generated by set-theme.sh — do not edit config manually.
# Change dotfiles/theme and run scripts/set-theme.sh

# Font
font = "JetBrains Mono"
font-size = 12

# Window
width = 400
height = 300
border-width = 1
outline-width = 0
corner-radius = 0
padding-left = 8
padding-right = 8
padding-top = 8
padding-bottom = 8

# Prompt
prompt-text = "> "

# Colors
background-color = {{BLACK}}
text-color = {{BASE}}
prompt-color = {{BASE}}
selection-color = {{BLACK}}
selection-background = {{BASE}}
border-color = {{BASE}}
input-color = {{BASE}}
input-background = {{BLACK}}

# Input
placeholder-text = ""
hide-cursor = false

# Result list
result-spacing = 4
num-results = 12
selection-padding = 4

# Behavior
fuzzy-match = true
require-match = true
auto-accept-single = false
hide-input = false
horizontal = false
