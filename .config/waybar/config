{
    "layer": "top",
    "position": "top",
    "height": 16,
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,

    "modules-left": ["hyprland/workspaces", "hyprland/submap"],
    "modules-center": [],
    "modules-right": ["cpu", "memory", "pulseaudio", "network", "clock"],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "persistent-workspaces": {
            "*": 5
        }
    },

    "hyprland/submap": {
        "format": " RESIZE",
        "tooltip": false
    },

    "cpu": {
        "format": "CPU:{usage:02}%",
        "interval": 2
    },

    "memory": {
        "format": "MEM:{percentage:02}%",
        "interval": 2
    },

    "pulseaudio": {
        "format": "VOL:{volume}%",
        "format-muted": "VOL:MUTE",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "network": {
        "format-wifi": "NET:OK",
        "format-ethernet": "NET:ETH",
        "format-disconnected": "NET:--",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "clock": {
        "format": "{:%Y-%m-%d %H:%M}",
        "tooltip": false
    }
}
