{
    "layer": "top",
    "position": "top",
    "height": 16,
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,

    "modules-left": ["hyprland/workspaces", "hyprland/submap"],
    "modules-center": ["custom/date", "clock"],
    "modules-right": ["custom/weather", "hyprland/language", "pulseaudio", "network"],

    "hyprland/workspaces": {
        "format": "{name}{windows}",
        "format-window-separator": " ",
        "window-rewrite-default": " ",
        "window-rewrite": {
            "firefox": " ",
            "chromium": " ",
            "google-chrome": " ",
            "brave-browser": " ",
            "Alacritty": " ",
            "kitty": " ",
            "ghostty": " ",
            "foot": " ",
            "org.codeberg.dnkl.foot": " ",
            "com.mitchellh.ghostty": " ",
            "code": " ",
            "Code": " ",
            "nvim": " ",
            "neovim": " ",
            "nautilus": " ",
            "org.gnome.Nautilus": " ",
            "thunar": " ",
            "nemo": " ",
            "dolphin": " ",
            "spotify": " ",
            "Spotify": " ",
            "discord": " ",
            "slack": " ",
            "telegram": " ",
            "org.telegram.desktop": " ",
            "steam": " ",
            "gimp": " ",
            "obs": " ",
            "mpv": " ",
            "vlc": " ",
            "org.wezfurlong.wezterm": " "
        },
        "on-click": "activate",
        "persistent-workspaces": {
            "*": 5
        }
    },

    "hyprland/submap": {
        "format": " RESIZE",
        "tooltip": false
    },

    "custom/weather": {
        "format": "{}",
        "exec": "curl -s 'wttr.in/?format=%c%t' 2>/dev/null || echo ' --'",
        "interval": 900,
        "tooltip": false
    },

    "hyprland/language": {
        "format": " {}",
        "format-en": "EN",
        "format-pt": "PT",
        "format-es": "ES",
        "format-de": "DE",
        "format-fr": "FR"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " MUTE",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": " {ifname}",
        "format-disconnected": " OFF",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "custom/date": {
        "format": " {}",
        "exec": "date '+%Y-%m-%d'",
        "interval": 60
    },

    "clock": {
        "format": " {:%H:%M}",
        "tooltip-format": "{:%A, %B %d, %Y}"
    }
}
