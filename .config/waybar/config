{
    "layer": "top",
    "position": "top",
    "height": 18,
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,

    "modules-left": ["hyprland/workspaces", "hyprland/submap", "hyprland/window"],
    "modules-center": [],
    "modules-right": ["tray", "cpu", "memory", "pulseaudio", "network", "battery", "clock"],

    "hyprland/workspaces": {
        "format": "[{name}]",
        "on-click": "activate",
        "persistent-workspaces": {
            "*": 5
        }
    },

    "hyprland/submap": {
        "format": "<RESIZE>",
        "tooltip": false
    },

    "hyprland/window": {
        "format": "| {title}",
        "max-length": 40,
        "separate-outputs": true
    },

    "tray": {
        "icon-size": 14,
        "spacing": 8
    },

    "cpu": {
        "format": "CPU:{usage:02}%",
        "interval": 2,
        "on-click": "ghostty -e btop"
    },

    "memory": {
        "format": "MEM:{percentage:02}%",
        "interval": 2,
        "on-click": "ghostty -e btop"
    },

    "pulseaudio": {
        "format": "VOL:{volume:02}%",
        "format-muted": "VOL:---",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },

    "network": {
        "format-wifi": "NET:{signalStrength:02}%",
        "format-ethernet": "NET:ETH",
        "format-disconnected": "NET:---",
        "tooltip-format": "{ifname}: {ipaddr}",
        "on-click": "ghostty -e nmtui"
    },

    "battery": {
        "format": "BAT:{capacity:02}%",
        "format-charging": "CHG:{capacity:02}%",
        "format-plugged": "PWR:{capacity:02}%",
        "format-critical": "LOW:{capacity:02}%",
        "states": {
            "warning": 30,
            "critical": 15
        }
    },

    "clock": {
        "format": "{:%Y-%m-%d|%H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "format": {
                "today": "<span color='#ff6600'><b>{}</b></span>"
            }
        }
    }
}
