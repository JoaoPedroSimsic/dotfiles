/* Generated by set-theme.sh — do not edit style.css manually.
   Change dotfiles/theme and run scripts/set-theme.sh
   
   90s TUI / CRT Style */

* {
    font-family: "Terminus", "IBM Plex Mono", "JetBrains Mono", monospace;
    font-size: 13px;
    border-radius: 0;
}

window {
    background-color: {{BLACK}};
    border: 3px solid {{BASE}};
    box-shadow: inset 0 0 20px rgba(255, 102, 0, 0.1);
}

#outer-box {
    background-color: {{BLACK}};
    padding: 0;
    margin: 0;
}

#input {
    background-color: {{BLACK}};
    color: {{BASE}};
    border: none;
    border-bottom: 1px dashed {{DIM}};
    padding: 8px 10px;
    margin: 4px;
}

#input:focus {
    outline: none;
    box-shadow: none;
}

#scroll {
    background-color: {{BLACK}};
    margin: 0;
}

#inner-box {
    background-color: {{BLACK}};
    padding: 0;
}

#entry {
    padding: 4px 10px;
    color: {{BASE}};
    background-color: transparent;
    border: none;
    margin: 0;
}

#entry:selected {
    background-color: {{BASE}};
    color: {{BLACK}};
}

#entry:hover {
    background-color: {{DIM}};
}

#img {
    margin-right: 8px;
}

#text {
    color: inherit;
    text-shadow: 0 0 2px {{BASE}};
}

#entry:selected #text {
    text-shadow: none;
}
