/* Generated by set-theme.sh — do not edit style.css manually.
   Change dotfiles/theme and run scripts/set-theme.sh */

* {
    font-family: "JetBrains Mono", "Terminus", monospace;
    font-size: 12px;
    border-radius: 0;
}

window {
    background-color: {{BLACK}};
    border: 1px solid {{BASE}};
}

#outer-box {
    background-color: {{BLACK}};
    padding: 4px;
    margin: 0;
}

#input {
    background-color: {{BLACK}};
    color: {{BASE}};
    border: 1px solid {{DIM}};
    padding: 6px 8px;
    margin-bottom: 4px;
}

#scroll {
    background-color: {{BLACK}};
    border: 1px solid {{DIM}};
}

#inner-box {
    background-color: {{BLACK}};
    padding: 0;
}

#entry {
    padding: 4px 8px;
    color: {{BASE}};
    background-color: transparent;
    border: none;
}

#entry:selected {
    background-color: {{BASE}};
    color: {{BLACK}};
}

#img {
    margin-right: 8px;
    -gtk-icon-effect: dim;
}

#text {
    color: inherit;
}
