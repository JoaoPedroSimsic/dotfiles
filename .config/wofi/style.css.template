/* Generated by set-theme.sh — do not edit style.css manually.
   Change dotfiles/theme and run scripts/set-theme.sh */

* {
    font-family: "JetBrains Mono", monospace;
    font-size: 14px;
}

window {
    background-color: {{BLACK}};
    border: 2px solid {{BASE}};
}

#input {
    background-color: {{BG}};
    color: {{BASE}};
    border: none;
    border-bottom: 1px solid {{DIM}};
    padding: 10px;
}

#input:focus {
    outline: none;
}

#outer-box {
    background-color: {{BLACK}};
}

#scroll {
    background-color: {{BLACK}};
}

#inner-box {
    background-color: {{BLACK}};
}

#entry {
    padding: 8px 10px;
    color: {{BASE}};
    background-color: transparent;
}

#entry:selected {
    background-color: {{BASE}};
    color: {{BLACK}};
}

#entry:hover {
    background-color: {{DIM}};
}

#img {
    margin-right: 10px;
}

#text {
    color: inherit;
}
