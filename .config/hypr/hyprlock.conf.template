    text = │
    color = $dim
    font_size = 14
    font_family = $font
    po dots_size = 0.2
    dots_spacing = 0.3
    dots_center = true
    outer_color = $base
    inner_color = $bg
    font_color = $base
    fade_on_empty = false
    placeholder_text =
    hide_input = false
    rounding = 0
    check_color = $base
    fail_color = $error
    fail_text = ACCESS DENIED
    capslock_color = $error
    position = 0, -10
    halign = center
    valign = center
}

# ── Input label ───────────────────────────────────────────────────────────────
label {
    monitor =
    text = [ ENTER PASSWORD ]
    color = $dim
    font_size = 10
    font_family = $font
    position = 0, -50
    halign = center
    valign = center
}

# ── User @ Host ───────────────────────────────────────────────────────────────
label {
    monitor =
    text = $USER@$HOST
    color = $dim
    font_size = 12
    font_family = $font
    position = 0, -100
    halign = center
    valign = center
}

# ── System locked label ───────────────────────────────────────────────────────
label {
    monitor =
    text = [ SYSTEM LOCKED ]
    color = $base
    font_size = 10
    font_family = $font
    position = 0, -150
    halign = center
    valign = center
}
