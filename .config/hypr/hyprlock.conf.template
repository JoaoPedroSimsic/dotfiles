# Hyprlock - Lock Screen Configuration
# Generated by set-theme.sh — do not edit manually.
# Change dotfiles/theme and run scripts/set-theme.sh

$base = rgba({{BASE}}ff)
$dim = rgba({{DIM}}ff)
$bg = rgba({{BG}}ff)
$black = rgba({{BLACK}}ff)
$error = rgba({{ERROR}}ff)
$font = JetBrains Mono

general {
    hide_cursor = true
    immediate_render = true
}

background {
    monitor =
    color = $black
    blur_passes = 0
}

# ── Top border ────────────────────────────────────────────────────────────────
label {
    monitor =
    text = ┌──────────────────────────────────────────┐
    color = $dim
    font_size = 14
    font_family = $font
    position = 0, 220
    halign = center
    valign = center
}

# ── Bottom border ─────────────────────────────────────────────────────────────
label {
    monitor =
    text = └──────────────────────────────────────────┘
    color = $dim
    font_size = 14
    font_family = $font
    position = 0, -220
    halign = center
    valign = center
}

